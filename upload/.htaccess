# Permetti solo immagini
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Blocca esecuzione PHP in questa cartella
<FilesMatch "\.php$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Blocca accesso a file .htaccess
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# Disabilita directory listing
Options -Indexes

# Disabilita esecuzione script
AddHandler cgi-script .php .pl .py .jsp .asp .htm .shtml .sh .cgi
Options -ExecCGI
